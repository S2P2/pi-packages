{
	"name": "pi-packages",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "biome check --error-on-warnings . && npm run typecheck",
		"check:fix": "biome check --write --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"version:packages": "changeset version && npm install --package-lock-only --ignore-scripts",
		"release": "npm run check && npm test && changeset publish",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "3.0.3",
		"@types/node": "22.20.5",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "npm@11.13.0"
}
